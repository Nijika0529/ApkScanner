# Copy this file to .env, chmod it to 600, and insert a newly generated key.
DEEPSEEK_API_KEY=

# Provider model (defaults to DeepSeek-V4.1-Flash; the legacy deepseek-v4-flash
# name is routed to the same model but is no longer used by ApkScanner).
# APKSCANNER_CODEX_MODEL=deepseek-flash
# APKSCANNER_CODEX_REASONING_EFFORT=high

# Local devices, including older Android versions, produce development-scoped verdicts.
APKSCANNER_VALIDATION_PROFILE=development
APKSCANNER_DEVICE_RESET_POLICY=never

# SQLite durability: EXTRA | FULL | NORMAL | OFF. FULL (default) fsyncs every
# commit, which is slow when creating the ~190-statement schema or writing many
# rows on slow storage; NORMAL is the standard WAL setting and OFF is for
# throwaway databases.
# APKSCANNER_SQLITE_SYNCHRONOUS=NORMAL

# Optional ASC (droidasc) bytecode-level inbound cross references. When enabled,
# results are recorded as static.droidasc Evidence and projected into each task's
# bounded agent context as xrefs.json. Install with: pip install -e '.[asc]'
# auto prefers the in-process library (no multiprocessing) and falls back to the
# droidasc CLI; pin library/cli if you want one transport.
# APKSCANNER_ASC_ENABLED=true
# APKSCANNER_ASC_TRANSPORT=auto
# APKSCANNER_ASC_PATH=droidasc
# APKSCANNER_ASC_WORKERS=8
# APKSCANNER_ASC_TIMEOUT_SECONDS=300
# APKSCANNER_ASC_MAX_QUERIES=24
# APKSCANNER_ASC_MAX_RESULTS_PER_QUERY=200
# APKSCANNER_ASC_CONTEXT_MAX_REFERENCES=400

# Phase-oriented local resource pools and Agent time budgets.
# Investigation concurrency follows the connected ADB pool:
#   connected phones N -> min(N, APKSCANNER_MAX_INVESTIGATION_CONCURRENCY,
#                             APKSCANNER_CODEX_MAX_SESSIONS) concurrent tasks.
# Draining devices and devices a probe marked unavailable do not count, so
# unplugging a phone narrows concurrency without a restart. With no device
# attached, APKSCANNER_AGENT_ANALYSIS_SLOTS (desktop-only analysis) rules
# instead; PoC compilation stays a separate pool.
# APKSCANNER_MAX_INVESTIGATION_CONCURRENCY=16
# APKSCANNER_AGENT_ANALYSIS_SLOTS=4
# APKSCANNER_POC_BUILD_SLOTS=2
# APKSCANNER_AGENT_INITIAL_PHASE_SECONDS=900
# APKSCANNER_AGENT_EXPLORATION_PHASE_SECONDS=600
# APKSCANNER_AGENT_CRITIC_PHASE_SECONDS=300
# APKSCANNER_AGENT_RESCUE_PHASE_SECONDS=480
# APKSCANNER_AGENT_FINAL_PHASE_SECONDS=180
# APKSCANNER_AGENT_NO_PROGRESS_LIMIT=3
# APKSCANNER_RESCUE_AUDIT_SAMPLE_RATE=0.15
# Standalone attack-chain sites admitted per scan; the rest stay as inventory.
# Sites whose handler is an exported component fold into that component task.
# APKSCANNER_MAX_STANDALONE_CHAIN_SITES=12
# Retry one fresh Adaptive Verifier attempt while reusing completed candidate checkpoints.
# APKSCANNER_ADAPTIVE_VERIFIER_RESUME_ATTEMPTS=1

# Optional independent semantic proof Judge. This is a separate, read-only
# Codex session authenticated with a ChatGPT subscription, not a DeepSeek API
# key. Point to an existing, explicitly selected Codex login directory; do
# not copy auth files into the worker image or an Agent workspace.
# APKSCANNER_SEMANTIC_JUDGE_ENABLED=true
# APKSCANNER_SEMANTIC_JUDGE_CODEX_HOME=/absolute/path/to/dedicated-codex-home
# APKSCANNER_SEMANTIC_JUDGE_MODEL=gpt-6-luna
# APKSCANNER_SEMANTIC_JUDGE_TIMEOUT_SECONDS=120

# Optional: pin the real host platform-tools adb and seed one or more devices.
# APKSCANNER_HOST_ADB=/absolute/path/to/platform-tools/adb
# APKSCANNER_ADB_SERIALS=device-serial,host.example:5555

# Optional: shared Linux IDALib MCP running on the WSL host. Docker workers reach
# it through the host-gateway alias already provisioned by APKScanner.
# APKSCANNER_IDA_MCP_ENABLED=true
# APKSCANNER_IDA_MCP_URL=http://apkscanner-host:8745/mcp
# APKSCANNER_IDA_MCP_TOOL_TIMEOUT=1800

# Optional: public TCP port range on the authorized remote (Aliyun) host. The
# Adaptive Verifier connects over SSH (port 22) but must bind any deployed
# callback page/service inside this externally reachable range.
# APKSCANNER_SSH_PUBLIC_PORT_RANGE=12000-16000
# SSH key copying into the verifier is disabled by default. The platform-owned
# Web observer tunnel below uses a dedicated SSH config on the host instead;
# never point verifier credential copying at a general-purpose ~/.ssh directory.
# APKSCANNER_ADAPTIVE_VERIFIER_COPY_HOST_SSH=false
# APKSCANNER_ADAPTIVE_VERIFIER_SSH_SOURCE=/absolute/path/to/observer-only-ssh
# APKSCANNER_EXTERNAL_OBSERVER_ORIGINS=https://observer.example.com

# Optional platform-owned HTTPS Web observer. The remote Nginx vhost must proxy
# only /web-observer/ to 127.0.0.1:15880; no internal gateway API is public.
# The dedicated SSH config may reference an existing key, but must contain one
# literal Host alias and no Include, Match, ProxyCommand, or preset forwarding.
# APKSCANNER_WEB_OBSERVER_REMOTE_ENABLED=true
# APKSCANNER_WEB_OBSERVER_SSH_ALIAS=observer
# APKSCANNER_WEB_OBSERVER_ALLOWED_SSH_ALIASES=observer
# APKSCANNER_WEB_OBSERVER_SSH_CONFIG=/absolute/path/to/observer-ssh.conf
# APKSCANNER_WEB_OBSERVER_PUBLIC_BASE_URL=https://observer.example.com
# APKSCANNER_WEB_OBSERVER_REMOTE_LOOPBACK_PORT=15880
