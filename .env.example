# Copy this file to .env, chmod it to 600, and insert a newly generated key.
DEEPSEEK_API_KEY=

# Local devices, including older Android versions, produce development-scoped verdicts.
APKSCANNER_VALIDATION_PROFILE=development
APKSCANNER_DEVICE_RESET_POLICY=never

# Optional: pin the real host platform-tools adb and seed one or more devices.
# APKSCANNER_HOST_ADB=/absolute/path/to/platform-tools/adb
# APKSCANNER_ADB_SERIALS=device-serial,host.example:5555
