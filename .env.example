# Copy this file to .env, chmod it to 600, and insert a newly generated key.
DEEPSEEK_API_KEY=

# Local devices, including older Android versions, produce development-scoped verdicts.
APKSCANNER_VALIDATION_PROFILE=development
APKSCANNER_DEVICE_RESET_POLICY=never

# Phase-oriented local resource pools and Agent time budgets.
# APKSCANNER_AGENT_ANALYSIS_SLOTS=4
# APKSCANNER_POC_BUILD_SLOTS=2
# APKSCANNER_AGENT_INITIAL_PHASE_SECONDS=900
# APKSCANNER_AGENT_CRITIC_PHASE_SECONDS=300
# APKSCANNER_AGENT_RESCUE_PHASE_SECONDS=480
# APKSCANNER_AGENT_FINAL_PHASE_SECONDS=180
# APKSCANNER_AGENT_NO_PROGRESS_LIMIT=3
# APKSCANNER_RESCUE_AUDIT_SAMPLE_RATE=0.15
# Retry one fresh Adaptive Verifier attempt while reusing completed candidate checkpoints.
# APKSCANNER_ADAPTIVE_VERIFIER_RESUME_ATTEMPTS=1

# Optional: pin the real host platform-tools adb and seed one or more devices.
# APKSCANNER_HOST_ADB=/absolute/path/to/platform-tools/adb
# APKSCANNER_ADB_SERIALS=device-serial,host.example:5555

# Optional: shared Linux IDALib MCP running on the WSL host. Docker workers reach
# it through the host-gateway alias already provisioned by APKScanner.
# APKSCANNER_IDA_MCP_ENABLED=true
# APKSCANNER_IDA_MCP_URL=http://apkscanner-host:8745/mcp
# APKSCANNER_IDA_MCP_TOOL_TIMEOUT=1800
