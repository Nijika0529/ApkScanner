FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

LABEL io.apkscanner.version="0.1.0" \
      io.apkscanner.sdk-version="0.144.4" \
      io.apkscanner.worker-protocol="2"

RUN apt-get update \
    && apt-get install -y --no-install-recommends android-tools-adb ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/apk-scanner
COPY pyproject.toml README.md ./
COPY backend ./backend
RUN python -m pip install --no-cache-dir .

ENTRYPOINT ["python", "-m", "apkscanner.codex_worker"]
