# Include this snippet INSIDE one dedicated HTTPS server block. Do not place
# it directly under nginx.conf's http-level conf.d/*.conf include.
# The worker-owned SSH tunnel listens only on 127.0.0.1:15880.
location ^~ /web-observer/ {
    limit_except GET POST { deny all; }
    proxy_pass http://127.0.0.1:15880;
    proxy_http_version 1.1;
    proxy_set_header Host observer.example.com;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 5s;
    proxy_send_timeout 15s;
    proxy_read_timeout 30s;
    client_max_body_size 16k;
    proxy_cache off;
    access_log off;
    add_header Referrer-Policy "no-referrer" always;
}
