<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.apkscanner.poc.webobserverattacker"
    android:versionCode="1"
    android:versionName="1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <!-- Adversarial negative control: ADB can grant this development permission,
         but the target fixture must still reject an ordinary app UID. -->
    <uses-permission android:name="android.permission.DUMP" />
    <queries>
        <provider android:authorities="io.apkscanner.adaptivecases.fixture" />
    </queries>
    <application android:allowBackup="false" android:debuggable="false"
        android:label="APKScanner Web Observer Attacker">
        <activity android:name=".LaunchActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".FixturePermissionProbeActivity" android:exported="true" />
    </application>
</manifest>
